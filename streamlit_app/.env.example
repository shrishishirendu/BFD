# Bihar Foundation Invitation Mailer - Environment Variables
# Copy this file to .env and fill in your values.

APP_TITLE=Bihar Foundation Invitation Mailer

# Microsoft Entra ID (Azure AD) settings
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_REDIRECT_URI=http://localhost:8501

# Microsoft Graph scopes (space-separated)
GRAPH_SCOPES=User.Read Mail.Send

# Default sender address
DEFAULT_SENDER=connect@biharfoundation.org.au

# Default email subject
DEFAULT_SUBJECT=Invitation from Bihar Foundation

# Output directory (relative to app root)
OUTPUT_DIR=output

# Feature flags
ENABLE_BULK_SEND=true
ENABLE_ATTACHMENT=true

# Test mode: when true, all emails are redirected to TEST_RECIPIENT
TEST_MODE=false
TEST_RECIPIENT=

# Bulk send throttle delay in seconds
BULK_SEND_DELAY=1.0
